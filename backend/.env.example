# Copy this file to ".env" in the backend/ folder and fill in real values.
# Never commit the real ".env" file — it's already in .gitignore.
#
# Nothing below is required to run the demo: with none of this set, the
# app still runs with password login + OTP-over-console-log, and the
# OAuth buttons simply stay hidden.

# --- Core ---
PORT=4000
# Any long random string. Rotate this for anything beyond a demo.
JWT_SECRET=change-me-to-a-long-random-string

# Used to build OAuth redirect URLs. Must match what you register with
# each provider as the callback URL, e.g.
#   http://localhost:4000/api/auth/oauth/google/callback
BACKEND_URL=http://localhost:4000
# Where OAuth redirects back to after login.
FRONTEND_URL=http://localhost:5173

# --- Email OTP (optional) ---
# If unset, OTPs are printed to this terminal instead of emailed —
# fine for a hackathon demo. Fill these in to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Google OAuth (optional) ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (optional) ---
# https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL: {BACKEND_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LinkedIn OAuth (optional) ---
# https://www.linkedin.com/developers/apps -> "Sign In with LinkedIn using OpenID Connect"
# Authorized redirect URL: {BACKEND_URL}/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
